# Chaves de API de dados de mercado
# -----------------------------------------------------------------------------
# Este arquivo é versionado e NUNCA contém valor. O real é `.env`, que está no
# .gitignore: preencha lá, no seu ambiente, e não cole a chave no chat, no
# código nem em comando visível.
# Regra: você preenche, o agente só confirma se a VARIÁVEL existe (spec R6).

# --- Fontes SEM chave (só funciona sem nada aqui) -----------------------------
# BCB PTAX ......... https://olinda.bcb.gov.br/olinda/servico/PTAX/versao/v1/odata/CotacaoDolarPeriodo(...)
# BCB SGS .......... https://api.bcb.gov.br/dados/serie/bcdata.sgs.<codigo>/dados   (máx. 10 anos/req.)
# Frankfurter ...... https://api.frankfurter.dev/v2/rates

# --- Fontes COM cadastro (cole o valor no .env) ------------------------------
# brapi (B3/Ibovespa) — 15.000 req/mês ....... https://brapi.dev/dashboard
BRAPI_API_KEY=

# EIA (WTI e Brent, oficial) — cadastro por e-mail ... https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# Alpha Vantage — 25 req/dia ....... https://www.alphavantage.co/support/
ALPHA_VANTAGE_API_KEY=

# Twelve Data — 8 créditos/min, 800/dia (sem cartão) ... https://twelvedata.com/pricing
TWELVE_DATA_API_KEY=

# Tiingo — 50/h, 1.000/dia ....... https://www.tiingo.com/account/token
TIINGO_API_KEY=

# Marketstack — 100 req/mês ....... https://marketstack.com/pricing
MARKETSTACK_ACCESS_KEY=

# Finnhub — 60 req/min ....... https://finnhub.io/register
FINNHUB_API_KEY=

# Nasdaq Data Link — por dataset ....... https://data.nasdaq.com
NASDAQ_DATA_LINK_API_KEY=

# CoinGecko (cripto) — Demo 100/min ....... https://www.coingecko.com/en/api
COINGECKO_API_KEY=